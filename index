let pool=[], current=0, answers={}, state='setup', mode='practice';
const el=id=>document.getElementById(id), esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const allTopics=[...new Set(BANK.map(q=>q.topic))];
el('chipAll').textContent=BANK.length+' questions total';el('chipOne').textContent=BANK.filter(q=>q.ch===1).length+' Chapter 1';el('chipTwo').textContent=BANK.filter(q=>q.ch===2).length+' Chapter 2';
function filtered(){let ch=el('chapter').value,t=el('topic').value;return BANK.filter(q=>(ch==='all'||String(q.ch)===ch)&&(t==='all'||q.topic===t));}
function refreshTopics(){let ch=el('chapter').value,prev=el('topic').value;let ts=[...new Set(BANK.filter(q=>ch==='all'||String(q.ch)===ch).map(q=>q.topic))];el('topic').innerHTML='<option value="all">Every topic</option>'+ts.map(t=>'<option value="'+esc(t)+'">'+esc(t)+'</option>').join('');if(ts.includes(prev))el('topic').value=prev;refreshAvailable();}
function refreshAvailable(){let n=filtered().length;el('available').textContent=n+' questions available for the selected coverage. The All questions option tests every available idea.';el('selectedCount').textContent=n;el('scope').textContent=el('chapter').value==='all'?'Both chapters':'Chapter '+el('chapter').value;el('modeLabel').textContent=el('mode').value==='exam'?'Exam':'Practice';}
['chapter','topic','mode','limit'].forEach(k=>el(k).addEventListener('change',k==='chapter'?refreshTopics:refreshAvailable));refreshTopics();
function show(view){state=view;['setup','quiz','results'].forEach(k=>el(k).classList.toggle('hidden',view!==k));el('navigator').classList.toggle('hidden',view!=='quiz');window.scrollTo({top:0,behavior:'instant'});}
function randomize(arr){let a=arr.slice();for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function start(){pool=filtered().slice();if(el('shuffle').checked)pool=randomize(pool);let l=el('limit').value;if(l!=='all')pool=pool.slice(0,+l);answers={};current=0;mode=el('mode').value;el('selectedCount').textContent=pool.length;el('modeLabel').textContent=mode==='exam'?'Exam':'Practice';el('sideHelp').textContent='Use the numbered buttons to jump between questions.';show('quiz');render();}
el('start').addEventListener('click',start);
function render(){let q=pool[current],val=answers[current];el('qcategory').textContent='Chapter '+q.ch+' · '+q.topic+' · Slide '+q.slide;el('qcounter').textContent='Question '+(current+1)+' of '+pool.length;el('qtext').textContent=q.q;el('answerButtons').innerHTML=q.options.map((o,i)=>{let cls=val===i?' selected':'';if(mode==='practice'&&val!==undefined){if(i===q.answer)cls+=' correct';else if(i===val)cls+=' wrong';}return '<button class="choice'+cls+'" data-i="'+i+'" '+(mode==='practice'&&val!==undefined?'disabled':'')+'><span class="letter">'+String.fromCharCode(65+i)+'</span><span>'+esc(o)+'</span></button>';}).join('');el('answerButtons').querySelectorAll('button').forEach(b=>b.onclick=()=>choose(+b.dataset.i));let fb=el('feedback');fb.classList.toggle('hidden',mode!=='practice'||val===undefined);if(mode==='practice'&&val!==undefined)fb.innerHTML='<strong>'+(val===q.answer?'✓ Correct':'✗ Incorrect')+'</strong><div>'+esc(q.why)+'</div>';let count=Object.keys(answers).length;el('answeredStat').textContent=count+' of '+pool.length+' answered';el('bar').style.width=(100*count/pool.length)+'%';el('answeredCount').textContent=count;el('remainingCount').textContent=pool.length-count;el('prev').disabled=current===0;el('next').disabled=current===pool.length-1;el('finish').textContent=count===pool.length?'Finish & grade':'Finish & grade ('+(pool.length-count)+' unanswered)';renderNav();}
function choose(i){if(mode==='practice'&&answers[current]!==undefined)return;answers[current]=i;render();}
function renderNav(){el('navigator').innerHTML=pool.map((q,i)=>'<button class="num '+(i===current?'current ':'')+(answers[i]!==undefined?'answered':'')+'" title="Question '+(i+1)+'" data-i="'+i+'">'+(i+1)+'</button>').join('');el('navigator').querySelectorAll('button').forEach(b=>b.onclick=()=>{current=+b.dataset.i;render();});}
el('prev').onclick=()=>{if(current>0){current--;render();}};el('next').onclick=()=>{if(current<pool.length-1){current++;render();}};
function finish(){let count=Object.keys(answers).length;if(count<pool.length&&!confirm('You have '+(pool.length-count)+' unanswered questions. Submit anyway?'))return;let correct=pool.filter((q,i)=>answers[i]===q.answer).length;let pct=Math.round(100*correct/pool.length);el('score').textContent=correct+' / '+pool.length;el('scoreText').textContent=pct+'% correct · '+(pool.length-count)+' unanswered · '+(pool.length-correct)+' incorrect or unanswered';el('sideHelp').textContent='Your exam has been submitted. Review explanations below.';el('navigator').classList.add('hidden');show('results');el('review').classList.add('hidden');}
el('finish').onclick=finish;
function review(onlyWrong){let items=pool.map((q,i)=>({...q,index:i,selected:answers[i]})).filter(q=>!onlyWrong||q.selected!==q.answer);el('review').innerHTML=items.length?items.map(q=>'<article class="reviewRow '+(q.selected===q.answer?'correctR':'incorrect')+'"><div class="small muted">Question '+(q.index+1)+' · Chapter '+q.ch+' · Slide '+q.slide+' · '+esc(q.topic)+'</div><strong>'+esc(q.q)+'</strong><p style="margin-bottom:4px">Your answer: <strong>'+esc(q.selected===undefined?'Not answered':q.options[q.selected])+'</strong></p><p style="margin-top:0">Correct answer: <strong style="color:var(--green)">'+esc(q.options[q.answer])+'</strong></p><div class="muted small">'+esc(q.why)+'</div></article>').join(''):'<p>Nothing to review — every answer was correct!</p>';el('review').classList.remove('hidden');el('review').scrollIntoView({behavior:'smooth',block:'start'});}
el('reviewAll').onclick=()=>review(false);el('reviewWrong').onclick=()=>review(true);
function reset(){if(state==='quiz'&&Object.keys(answers).length&&!confirm('Restart? Your current answers will be lost.'))return;pool=[];answers={};current=0;el('answeredCount').textContent='0';el('remainingCount').textContent='—';el('sideHelp').textContent='Choose your settings and select Start quiz.';refreshAvailable();show('setup');}
el('restart').onclick=reset;el('quit').onclick=reset;
